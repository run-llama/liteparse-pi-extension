{
  "name": "@llamaindex/liteparse-pi-extension",
  "version": "0.1.1",
  "description": "Extension for Pi agent which adds parsing, screenshotting and lexical search capabilities over unstructured documents",
  "license": "MIT",
  "author": {
    "email": "clelia@runllama.ai",
    "name": "Clelia Astra Bertelli",
    "url": "https://github.com/AstraBert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/run-llama/liteparse-pi-extension.git"
  },
  "bugs": {
    "url": "https://github.com/run-llama/liteparse-pi-extension/issues"
  },
  "homepage": "https://github.com/run-llama/liteparse-pi-extension#readme",
  "keywords": [
    "parsing",
    "text-extraction",
    "liteparse",
    "pdfs",
    "images",
    "office-files",
    "ai-agents",
    "agentic-document-understanding"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier .",
    "lint": "eslint --fix src/",
    "lint:check": "eslint src/",
    "changeset": "changeset",
    "bump": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.75.4",
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "@llamaindex/liteparse": "2.0.0-beta.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
